<mujoco>
  <compiler angle="radian"/>

  <worldbody>
    <light pos="0 -2 3" dir="0 0.5 -1"/>
    <geom name="floor" type="plane" size="10 10 0.1" rgba="0.2 0.2 0.2 1"/>

    <body name="base" pos="0 0 0.11">
      <geom type="box" size="0.35 0.25 0.08" rgba="0.85 0.6 0.1 1" contype="0" conaffinity="0"/>

      <!-- 可前傾的門架（tilt）：繞 y 軸，往前（+x 傾倒）為正 -->
      <body name="mast" pos="0.38 0 0">
        <joint name="tilt" type="hinge" axis="0 1 0" range="0 0.8" damping="2"/>
        <geom type="box" size="0.03 0.2 0.4" pos="0 0 0.4" rgba="0.4 0.4 0.45 1"/>

        <body name="carriage" pos="0.04 0 0.12">
          <joint name="lift" type="slide" axis="0 0 1" range="0 0.65" damping="5"/>
          <geom type="box" size="0.02 0.2 0.06" rgba="0.7 0.2 0.2 1" contype="0" conaffinity="0"/>

          <body name="forks" pos="0.04 0 0">
            <geom type="box" size="0.3 0.025 0.012" pos="0.3  0.08 -0.05" rgba="0.85 0.85 0.2 1" friction="0.1 0.05 0.01"/>
            <geom type="box" size="0.3 0.025 0.012" pos="0.3 -0.08 -0.05" rgba="0.85 0.85 0.2 1" friction="0.1 0.05 0.01"/>
          </body>
        </body>
      </body>
    </body>

    <!-- 棧板放在牙叉上；CG_OFFSET 可模擬重心偏移 -->
    <body name="pallet" pos="0.72 0 0.082">
      <freejoint/>
      <geom type="box" size="0.25 0.2 0.02" pos="0 0 0.10" rgba="PALLET_RGBA" friction="PALLET_FRICTION 0.05 0.01"/>
      <geom type="box" size="0.04 0.04 0.05" pos=" 0.2  0.15 0.05" rgba="PALLET_RGBA" friction="PALLET_FRICTION 0.05 0.01"/>
      <geom type="box" size="0.04 0.04 0.05" pos=" 0.2 -0.15 0.05" rgba="PALLET_RGBA" friction="PALLET_FRICTION 0.05 0.01"/>
      <geom type="box" size="0.04 0.04 0.05" pos="-0.2  0.15 0.05" rgba="PALLET_RGBA" friction="PALLET_FRICTION 0.05 0.01"/>
      <geom type="box" size="0.04 0.04 0.05" pos="-0.2 -0.15 0.05" rgba="PALLET_RGBA" friction="PALLET_FRICTION 0.05 0.01"/>
      <inertial pos="CG_OFFSET 0 0.06" mass="20" diaginertia="0.15 0.15 0.1"/>
    </body>
  </worldbody>

  <actuator>
    <position name="tilt_ctl" joint="tilt" kp="500" kv="50" ctrllimited="true" ctrlrange="0 0.8"/>
    <position name="lift_ctl" joint="lift" kp="1500" kv="80" ctrllimited="true" ctrlrange="0 0.65"/>
  </actuator>
</mujoco>
