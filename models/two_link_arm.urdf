<?xml version="1.0"?>
<robot name="two_link_arm">

  <!-- MuJoCo 擴充區段：嵌入在 URDF 的 robot 元素底下 -->
  <mujoco>
    <compiler angle="radian" balanceinertia="true"/>
    <option gravity="0 0 -9.81" timestep="0.002"/>
  </mujoco>

  <link name="base">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.1 0.1 0.05"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.1 0.1 0.05"/></geometry>
    </collision>
  </link>

  <link name="link1">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 -0.25"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.25" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.02" length="0.5"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.25" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.02" length="0.5"/></geometry>
    </collision>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="10"/>
  </joint>

  <link name="link2">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 -0.2"/>
      <inertia ixx="0.007" ixy="0" ixz="0" iyy="0.007" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.2" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.015" length="0.4"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.2" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.015" length="0.4"/></geometry>
    </collision>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 -0.5" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="10"/>
  </joint>

</robot>
