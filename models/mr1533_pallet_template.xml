<mujoco model="mr1533_pallet_scene">
  <compiler angle="radian" meshdir="models/meshes/"/>

  <asset>
    <mesh name="chassis"   file="mr1533/forward_fixed.obj"/>
    <mesh name="mast"      file="mr1533/lift_fixed.obj"/>
    <mesh name="carriage"  file="mr1533/fork_liftA1.obj"/>
    <mesh name="tiltfix"   file="mr1533/tilt_fixed.obj"/>
    <mesh name="forks"     file="mr1533/fork_tilt.obj"/>
    <mesh name="wheel"     file="mr1533/front_left.obj"/>
    <mesh name="pallet"    file="PALLET_OBJ"/>  <!-- MuJoCo 會把 mesh 對齊主軸，geom 需逆轉補償（見 19 章） -->   <!-- pallet_wood.obj / pallet_plastic.obj -->
  </asset>

  <default>
    <default class="visual">
      <geom contype="0" conaffinity="0" group="2"/>
    </default>
  </default>

  <worldbody>
    <light pos="2 -3 4" dir="-0.4 0.6 -1"/>
    <geom name="floor" type="plane" size="10 10 0.1" rgba="0.25 0.25 0.28 1"/>

    <body name="base" pos="0 0 0">
      <joint name="move_x" type="slide" axis="1 0 0" damping="50"/>
      <joint name="move_y" type="slide" axis="0 1 0" damping="50"/>
      <joint name="yaw"    type="hinge" axis="0 0 1" damping="50"/>
      <inertial pos="0.85 0 0.6" mass="2000" diaginertia="800 800 800"/>
      <geom type="box" size="0.55 0.65 0.30" pos="1.15 0 0.35" group="3" rgba="0.6 0.6 0.62 1"/>
      <geom class="visual" type="mesh" mesh="chassis" rgba="0.75 0.76 0.78 1"/>
      <geom class="visual" type="mesh" mesh="wheel" pos="0  0.454 0.127" rgba="0.05 0.05 0.05 1"/>
      <geom class="visual" type="mesh" mesh="wheel" pos="0 -0.454 0.127" rgba="0.05 0.05 0.05 1"/>

      <body name="mast" pos="0.85 0 0">
        <inertial pos="0 0 1.17" mass="150" diaginertia="70 60 10"/>
        <geom class="visual" type="mesh" mesh="mast" rgba="0.35 0.36 0.38 1"/>
        <geom type="box" size="0.04 0.45 1.1" pos="0 0 1.17" group="3" rgba="0.35 0.36 0.38 1"/>

        <body name="carriage1" pos="-0.14 0 0">
          <joint name="lift1" type="slide" axis="0 0 1" range="0 1.5" damping="20"/>
          <inertial pos="0 0 1.3" mass="60" diaginertia="26 24 2.5"/>
          <geom class="visual" type="mesh" mesh="carriage" rgba="0.35 0.36 0.38 1"/>

          <body name="carriage2" pos="-0.09 0 0.29">
            <joint name="lift2" type="slide" axis="0 0 1" range="0 1.5" damping="20"/>
            <inertial pos="0 0 0.24" mass="50" diaginertia="2.2 1.2 1.3"/>
            <geom class="visual" type="mesh" mesh="tiltfix" rgba="0.35 0.36 0.38 1"/>

            <body name="fork" pos="-0.12 0 0">
              <joint name="tilt" type="hinge" axis="0 1 0" range="-0.3 0.3" damping="10"/>
              <inertial pos="-0.5 0 0.3" mass="40" diaginertia="5 5 1"/>
              <geom class="visual" type="mesh" mesh="forks" rgba="0.3 0.3 0.32 1"/>
              <geom type="box" size="0.48 0.16 0.015" pos="-0.62  0.315 -0.205" group="3" friction="0.1 0.05 0.01"/>
              <geom type="box" size="0.48 0.16 0.015" pos="-0.62 -0.315 -0.205" group="3" friction="0.1 0.05 0.01"/>
              <site name="fork_tip" pos="-1.1 0 -0.21" size="0.01"/>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- 棧板（Blender 建模，1.0×0.8 m、20 kg）：枕木方向對齊 x（牙叉從 -x 端進入） -->
    <body name="pallet" pos="-0.4 0 0" euler="0 0 1.5707963">
      <freejoint/>
      <inertial pos="0 0 0.06" mass="20" diaginertia="0.15 0.15 0.1"/>
      <geom class="visual" type="mesh" mesh="pallet" rgba="PALLET_RGBA"/>
      <!-- 碰撞：板面 + 三根枕木 -->
      <geom type="box" size="0.5 0.4 0.011" pos="0 0 0.101" friction="PALLET_FRICTION 0.05 0.01" group="3" rgba="PALLET_RGBA"/>
      <geom type="box" size="0.05 0.4 0.045" pos="-0.42 0 0.045" friction="PALLET_FRICTION 0.05 0.01" group="3" rgba="PALLET_RGBA"/>
      <geom type="box" size="0.05 0.4 0.045" pos="0 0 0.045"     friction="PALLET_FRICTION 0.05 0.01" group="3" rgba="PALLET_RGBA"/>
      <geom type="box" size="0.05 0.4 0.045" pos="0.42 0 0.045"  friction="PALLET_FRICTION 0.05 0.01" group="3" rgba="PALLET_RGBA"/>
    </body>
  </worldbody>

  <actuator>
    <velocity name="vx"   joint="move_x" kv="5000" ctrlrange="-1.5 1.5"/>
    <velocity name="vy"   joint="move_y" kv="5000" ctrlrange="-1.5 1.5"/>
    <velocity name="wyaw" joint="yaw"    kv="2000" ctrlrange="-1.5 1.5"/>
    <position name="lift1_ctl" joint="lift1" kp="30000" kv="3000" ctrllimited="true" ctrlrange="0 1.5"/>
    <position name="lift2_ctl" joint="lift2" kp="20000" kv="2000" ctrllimited="true" ctrlrange="0 1.5"/>
    <position name="tilt_ctl"  joint="tilt"  kp="5000"  kv="500"  ctrllimited="true" ctrlrange="-0.3 0.3"/>
  </actuator>

  <sensor>
    <framepos objtype="site" objname="fork_tip"/>
  </sensor>
</mujoco>
