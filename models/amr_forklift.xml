<mujoco>
  <compiler angle="radian"/>

  <option timestep="0.002"/>

  <default>
    <geom friction="1.0 0.05 0.01"/>
  </default>

  <worldbody>
    <light pos="0 -2 3" dir="0 0.5 -1"/>
    <geom name="floor" type="plane" size="10 10 0.1" rgba="0.2 0.2 0.2 1"/>

    <!-- ===== AMR 底盤（平面式簡化模型：x/y 滑動 + 偏航旋轉）===== -->
    <body name="base" pos="0 0 0.11">
      <joint name="move_x" type="slide" axis="1 0 0" damping="2"/>
      <joint name="move_y" type="slide" axis="0 1 0" damping="2"/>
      <joint name="yaw"    type="hinge" axis="0 0 1" damping="2"/>
      <geom type="box" size="0.35 0.25 0.08" rgba="0.85 0.6 0.1 1"/>
      <!-- 裝飾用輪子（不參與驅動） -->
      <geom type="cylinder" size="0.08 0.03" pos=" 0.22  0.18 -0.04" euler="1.5708 0 0" rgba="0.1 0.1 0.1 1" contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.08 0.03" pos=" 0.22 -0.18 -0.04" euler="1.5708 0 0" rgba="0.1 0.1 0.1 1" contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.08 0.03" pos="-0.22  0.18 -0.04" euler="1.5708 0 0" rgba="0.1 0.1 0.1 1" contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.08 0.03" pos="-0.22 -0.18 -0.04" euler="1.5708 0 0" rgba="0.1 0.1 0.1 1" contype="0" conaffinity="0"/>

      <!-- ===== 門架（mast，固定於底盤前方）===== -->
      <geom type="box" size="0.03 0.2 0.4" pos="0.38 0 0.4" rgba="0.4 0.4 0.45 1"/>

      <!-- ===== 牙叉滑架：上下（lift）===== -->
      <body name="carriage" pos="0.42 0 0.12">
        <joint name="lift" type="slide" axis="0 0 1" range="0 0.65" damping="5"/>
        <geom type="box" size="0.02 0.2 0.06" rgba="0.7 0.2 0.2 1"/>

        <!-- ===== 牙叉：左右側移（sideshift）===== -->
        <body name="forks" pos="0.04 0 0">
          <joint name="sideshift" type="slide" axis="0 1 0" range="-0.12 0.12" damping="2"/>
          <geom type="box" size="0.3 0.025 0.012" pos="0.3  0.08 -0.05" rgba="0.85 0.85 0.2 1"/>
          <geom type="box" size="0.3 0.025 0.012" pos="0.3 -0.08 -0.05" rgba="0.85 0.85 0.2 1"/>
          <site name="fork_tip" pos="0.6 0 -0.05" size="0.01"/>
        </body>
      </body>
    </body>

    <!-- 地板上的棧板貨物：板面 + 四隻腳（底下留空隙給牙叉插入） -->
    <body name="pallet" pos="1.5 0.3 0">
      <freejoint/>
      <geom type="box" size="0.25 0.2 0.02" pos="0 0 0.12" rgba="0.5 0.35 0.2 1" mass="5"/>
      <geom type="box" size="0.04 0.04 0.05" pos=" 0.2  0.15 0.05" rgba="0.4 0.28 0.15 1"/>
      <geom type="box" size="0.04 0.04 0.05" pos=" 0.2 -0.15 0.05" rgba="0.4 0.28 0.15 1"/>
      <geom type="box" size="0.04 0.04 0.05" pos="-0.2  0.15 0.05" rgba="0.4 0.28 0.15 1"/>
      <geom type="box" size="0.04 0.04 0.05" pos="-0.2 -0.15 0.05" rgba="0.4 0.28 0.15 1"/>
    </body>
  </worldbody>

  <actuator>
    <velocity name="vx"    joint="move_x" kv="60" ctrlrange="-1.5 1.5"/>
    <velocity name="vy"    joint="move_y" kv="60" ctrlrange="-1.5 1.5"/>
    <velocity name="wyaw"  joint="yaw"    kv="10" ctrlrange="-2 2"/>
    <position name="lift_ctl"  joint="lift"      kp="2000" ctrllimited="true" ctrlrange="0 0.65"/>
    <position name="shift_ctl" joint="sideshift" kp="100" ctrllimited="true" ctrlrange="-0.12 0.12"/>
  </actuator>

  <sensor>
    <jointpos joint="lift"/>
    <jointpos joint="sideshift"/>
    <framepos objtype="site" objname="fork_tip"/>
  </sensor>
</mujoco>
