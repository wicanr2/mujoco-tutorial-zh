<mujoco>
  <compiler angle="radian"/>

  <worldbody>
    <light pos="0 -2 3" dir="0 0.5 -1"/>
    <geom name="floor" type="plane" size="10 10 0.1" rgba="0.2 0.2 0.2 1"/>

    <!-- ===== AMR 叉車底盤（簡化：固定不動，專注牙叉動作）===== -->
    <body name="base" pos="0 0 0.11">
      <geom type="box" size="0.35 0.25 0.08" rgba="0.85 0.6 0.1 1" contype="0" conaffinity="0"/>
      <geom type="box" size="0.03 0.2 0.4" pos="0.38 0 0.4" rgba="0.4 0.4 0.45 1"/>

      <!-- 牙叉滑架：上下 -->
      <body name="carriage" pos="0.42 0 0.12">
        <joint name="lift" type="slide" axis="0 0 1" range="0 0.65" damping="5"/>
        <geom type="box" size="0.02 0.2 0.06" rgba="0.7 0.2 0.2 1" contype="0" conaffinity="0"/>

        <!-- 牙叉：左右側移 -->
        <body name="forks" pos="0.04 0 0">
          <joint name="sideshift" type="slide" axis="0 1 0" range="-0.12 0.12" damping="2"/>
          <!-- 鋼製牙叉，摩擦係數固定 1.0 -->
          <geom type="box" size="0.3 0.025 0.012" pos="0.3  0.08 -0.05" rgba="0.85 0.85 0.2 1" friction="0.1 0.05 0.01"/>
          <geom type="box" size="0.3 0.025 0.012" pos="0.3 -0.08 -0.05" rgba="0.85 0.85 0.2 1" friction="0.1 0.05 0.01"/>
        </body>
      </body>
    </body>

    <!-- ===== 棧板（直接放在牙叉上）：腳底接觸牙叉頂面 =====
         牙叉頂面 z = 0.12 - 0.05 + 0.012 = 0.082，棧板腳底貼齊 -->
    <body name="pallet" pos="0.72 0 0.082">
      <freejoint/>
      <geom name="deck"  type="box" size="0.25 0.2 0.02" pos="0 0 0.10" rgba="PALLET_RGBA" friction="PALLET_FRICTION 0.05 0.01"/>
      <geom name="foot1" type="box" size="0.04 0.04 0.05" pos=" 0.2  0.15 0.05" rgba="PALLET_RGBA" friction="PALLET_FRICTION 0.05 0.01"/>
      <geom name="foot2" type="box" size="0.04 0.04 0.05" pos=" 0.2 -0.15 0.05" rgba="PALLET_RGBA" friction="PALLET_FRICTION 0.05 0.01"/>
      <geom name="foot3" type="box" size="0.04 0.04 0.05" pos="-0.2  0.15 0.05" rgba="PALLET_RGBA" friction="PALLET_FRICTION 0.05 0.01"/>
      <geom name="foot4" type="box" size="0.04 0.04 0.05" pos="-0.2 -0.15 0.05" rgba="PALLET_RGBA" friction="PALLET_FRICTION 0.05 0.01"/>
      <inertial pos="0 0 0.06" mass="20" diaginertia="0.15 0.15 0.1"/>
    </body>
  </worldbody>

  <actuator>
    <position name="lift_ctl"  joint="lift"      kp="1500" kv="80" ctrllimited="true" ctrlrange="0 0.65"/>
    <position name="shift_ctl" joint="sideshift" kp="2500" kv="10"  ctrllimited="true" ctrlrange="-0.12 0.12"/>
  </actuator>
</mujoco>
